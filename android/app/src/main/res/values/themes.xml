<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KBStudioScreen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/graphite</item>
        <item name="android:statusBarColor">@color/graphite</item>
        <item name="android:navigationBarColor">@color/graphite</item>
    </style>
    <style name="Theme.KBStudioScreen.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <color name="graphite">#FF120A24</color>
    <color name="orange">#FFFF2E88</color>
</resources>
